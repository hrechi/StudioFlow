{
  "name": "reframe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:portfolio": "vitest run src/modules/portfolio/tests",
    "test:facturation": "vitest run src/modules/facturation/tests",
    "test:invitations": "vitest run src/modules/invitations/tests",
    "test:materiel": "vitest run src/modules/materiel/tests",
    "test:snapseal": "vitest run src/modules/snapseal/tests",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:admin": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-admin.ts",
    "test:admin-auth": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-admin-auth.ts",
    "reset:admin-password": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/reset-admin-password.ts",
    "seed:facturation": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-facturation.ts",
    "seed:materiel": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-materiel.ts",
    "seed:inventaire": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-inventaire.ts",
    "seed:reservations": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-reservations.ts",
    "seed:galeries": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-galeries.ts",
    "seed:demo": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-demo.ts && npm run seed:materiel",
    "seed:stats": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-stats.ts",
    "index:elasticsearch": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/index-elasticsearch.ts",
    "test:elasticsearch": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/test-elasticsearch.ts",
    "seed:invitations": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-invitations.ts",
    "seed:accounts": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-accounts.ts",
    "seed:journee": "tsx --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-ma-journee.ts",
    "seed:all": "npm run seed:admin && npm run seed:accounts && npm run seed:facturation && npm run seed:demo && npm run seed:invitations && npm run seed:inventaire && npm run seed:reservations && npm run seed:galeries && npm run seed:stats"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@elastic/elasticsearch": "^8.19.2",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/el-messiri": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/reem-kufi": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@types/leaflet": "1.9.22",
    "@types/three": "^0.182.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "ethers": "6.17.0",
    "fflate": "^0.8.3",
    "framer-motion": "^14.9.0",
    "groq-sdk": "^1.6.0",
    "konva": "^10.9.1",
    "leaflet": "1.9.4",
    "lucide-react": "^1.57.0",
    "maath": "^0.10.8",
    "mongoose": "^9.11.2",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "next-pwa": "^5.6.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "react-konva": "^19.3.2",
    "react-leaflet": "5.0.0",
    "react-pageflip": "^2.0.3",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "three": "^0.182.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
