# Copy to .env.local (npm run dev) and/or .env (docker compose), then fill in the values.
# With Docker, MONGODB_URI is ignored: docker-compose.yml points the app to its own mongo service.

# Docker MongoDB (docker-compose.yml exposes it on port 27018)
MONGODB_URI=mongodb://127.0.0.1:27018/reframe

# Auth.js secret (any long random string). Generate one with:
#   openssl rand -base64 32
#   or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=afEVkW4NcvRSdm38lS9aNu7iaff+fWoCXFCG5oPG8Y8=

# First ADMIN account, created by: npm run seed:admin
ADMIN_EMAIL=admin@reframe.tn
# At least 8 characters, with a letter and a digit
ADMIN_PASSWORD=

# Test data for billing: npm run seed:facturation [-- --reset]
# (Docker: docker compose run --rm seed npx tsx scripts/seed-facturation.ts [--reset])
# Password of the seeded *@reframe.test client accounts; empty = the default in scripts/seed-facturation.ts
SEED_CLIENT_PASSWORD=


# ── Stripe (second gateway, test mode, charged in EUR — Stripe does not support TND) ──
# Free test key (sk_test_…): https://dashboard.stripe.com/test/apikeys · test card 4242 4242 4242 4242
STRIPE_SECRET_KEY=
# Optional: secret of a webhook endpoint (whsec_…) for /api/facturation/paiements/stripe/webhook
# (local: stripe listen --forward-to localhost:3000/api/facturation/paiements/stripe/webhook)
STRIPE_WEBHOOK_SECRET=
# EUR charged per 1 TND
STRIPE_TND_EUR_RATE=0.3
# Without any gateway key: true = show a test checkout (no real money) even in a production build (Docker demo)
PAIEMENT_SIMULATION=true

# ── Chatbot IA ──────────────────────────────────────────────────────────────
# Clé API Google Gemini (https://aistudio.google.com/app/apikey) — chatbot + AI payment proof checker
GEMINI_API_KEY=
# Optional spare keys (comma-separated), tried automatically when the main key hits its quota (429)
GEMINI_API_KEYS=
# Modèle Gemini à utiliser (défaut : gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Coordonnées du studio affichées par le chatbot quand un visiteur demande à contacter le studio
STUDIO_CONTACT_EMAIL=contact@reframe.tn
STUDIO_CONTACT_PHONE=

# ── Reviews & complaints (avis-reclamations) ──
# Optional server-side AI features (OpenAI-compatible chat completions API)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1/chat/completions

# API Ninjas profanity moderation through RapidAPI
RAPIDAPI_KEY=89a16366efmshe2cb9cba69559adp19f87cjsn79dd3ae72ad5
RAPIDAPI_PROFANITY_HOST=profanity-filter-by-api-ninjas.p.rapidapi.com
RAPIDAPI_PROFANITY_URL=https://profanity-filter-by-api-ninjas.p.rapidapi.com/v1/profanityfilter

# ── Portfolio (gestion-portfolio) ──
# Portfolio module integrations (set to false when real module services are wired).
USE_MOCKS=true
PORTFOLIO_BASE_URL=http://localhost:3000
# The portfolio AI features use the same GEMINI_API_KEY as the chatbot (above).
# Leave GEMINI_MODEL unset so each module keeps its own default
# (chatbot: gemini-2.5-flash, portfolio: gemini-3.5-flash-lite), or set it to force one model for both.

# Required for signed personal-photo uploads from the portfolio editor.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Photos & Galleries AI (Claude) ──
# Photo analysis after upload, auto-culling, story order and natural-language search.
# Key: https://console.anthropic.com/settings/keys · empty = the AI buttons explain how to enable it
ANTHROPIC_API_KEY=
# Optional model override (default: claude-haiku-5-5, the fastest and cheapest Claude model)
# CLAUDE_MODEL=claude-haiku-5-5
