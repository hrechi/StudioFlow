# Copy to .env.local (npm run dev) and/or .env (docker compose), then fill in the values.
# With Docker, MONGODB_URI is ignored: docker-compose.yml points the app to its own mongo service.

# Local MongoDB Community Server (Compass connects to mongodb://127.0.0.1:27017)
MONGODB_URI=mongodb://127.0.0.1:27017/reframe

# Auth.js secret (any long random string). Generate one with:
#   openssl rand -base64 32
#   or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# First ADMIN account, created by: npm run seed:admin
ADMIN_EMAIL=admin@reframe.tn
# At least 8 characters, with a letter and a digit
ADMIN_PASSWORD=

# Optional server-side AI features (OpenAI-compatible chat completions API)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1/chat/completions

# API Ninjas profanity moderation through RapidAPI
RAPIDAPI_KEY=89a16366efmshe2cb9cba69559adp19f87cjsn79dd3ae72ad5
RAPIDAPI_PROFANITY_HOST=profanity-filter-by-api-ninjas.p.rapidapi.com
RAPIDAPI_PROFANITY_URL=https://profanity-filter-by-api-ninjas.p.rapidapi.com/v1/profanityfilter
