# Copy to .env.local and fill in the values.

# Local MongoDB Community Server (Compass connects to mongodb://127.0.0.1:27017)
MONGODB_URI=mongodb://127.0.0.1:27017/studioflow

# Auth.js secret — generate one with: npx auth secret
AUTH_SECRET=

# First ADMIN account, created by: npm run seed:admin
ADMIN_EMAIL=admin@studioflow.tn
# At least 8 characters, with a letter and a digit
ADMIN_PASSWORD=
