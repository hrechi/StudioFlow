# Copy to .env.local (npm run dev) and/or .env (docker compose), then fill in the values.
# With Docker, MONGODB_URI is ignored: docker-compose.yml points the app to its own mongo service.

# Local MongoDB Community Server (Compass connects to mongodb://127.0.0.1:27017)
MONGODB_URI=mongodb://127.0.0.1:27017/reframe

# Auth.js secret (any long random string). Generate one with:
#   openssl rand -base64 32
#   or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# First ADMIN account, created by: npm run seed:admin
ADMIN_EMAIL=admin@reframe.tn
# At least 8 characters, with a letter and a digit
ADMIN_PASSWORD=

# Test data for billing: npm run seed:facturation [-- --reset]
# (Docker: docker compose run --rm seed npx tsx scripts/seed-facturation.ts [--reset])
# Password of the seeded *@reframe.test client accounts; empty = the default in scripts/seed-facturation.ts
SEED_CLIENT_PASSWORD=

# ── Chatbot IA ──────────────────────────────────────────────────────────────
# Clé API Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
# Modèle Gemini à utiliser (défaut : gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Coordonnées du studio affichées par le chatbot quand un visiteur demande à contacter le studio
STUDIO_CONTACT_EMAIL=contact@reframe.tn
STUDIO_CONTACT_PHONE=
